# ローカル開発用。秘密の値は入れない
ENVIRONMENT=local           # local にすると、請求側の署名の検査を省く（ローカル専用）
SIGNER_MODE=local            # local（テスト用の鍵。メモリ上）| kms（Cloud KMS）
STORE_BACKEND=memory         # memory | firestore
BANK_MODE=stub               # stub | http（bank-adapter を呼ぶ）
KMS_PARTICIPANT_KEY_VERSION= # projects/.../cryptoKeyVersions/1（参加者の委任状の署名鍵）
KMS_PAYMENT_AGENT_KEY_VERSION=
BANK_ADAPTER_URL=
PAYMENT_API_URL=             # 呼び出し元の ID トークンの audience（自分の URL）
GATEWAY_SERVICE_ACCOUNT=
API_SERVICE_ACCOUNT=
SCHEDULER_SERVICE_ACCOUNT=
