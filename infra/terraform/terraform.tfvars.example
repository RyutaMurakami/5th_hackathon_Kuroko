project_id        = "your-gcp-project-id"
region            = "us-central1"
github_repository = "owner/repo"

# Firebase Hosting のドメイン（https://<site>.web.app など）と、ローカル開発のオリジン
cors_allowed_origins = [
  "https://your-gcp-project-id.web.app",
  "https://your-gcp-project-id.firebaseapp.com",
  "http://localhost:3000",
]

# Secret Manager に値を登録したシークレットだけを並べる（human_task P3）
wired_secrets = []

# 呼び先のルート（TASKS B17）ができたら false にする
scheduler_paused = true
