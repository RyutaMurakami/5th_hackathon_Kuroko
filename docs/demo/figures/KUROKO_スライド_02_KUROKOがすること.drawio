<mxCell id="c6" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;1. 依頼&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#141D2E;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="180" y="180" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;font style=&quot;font-size: 18px;&quot; color=&quot;#141D2E&quot;&gt;依頼を整理し、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot; color=&quot;#141D2E&quot;&gt;不足だけを聞く。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot; color=&quot;#141D2E&quot;&gt;規程は、文書を&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot; color=&quot;#141D2E&quot;&gt;調べて答える&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="180" y="270" width="180" height="250" as="geometry"/></mxCell>
