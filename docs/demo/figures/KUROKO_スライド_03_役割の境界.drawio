<mxfile host="app.diagrams.net" type="device"><diagram id="役割の境界" name="役割の境界"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="c1" value="AI は、お金と個人情報に直接触れない" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#141D2E;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="44" as="geometry"/></mxCell>
<mxCell id="c2" value="お金の仕事まで任せられるように、役割の境界そのものを、いちばんの安全策にした" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#5A6478;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1520" height="30" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;AI（エージェント・Gemini）&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F8C450;strokeColor=#F8C450;strokeWidth=1.5;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="480" height="70" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#7A4E00&quot;&gt;&lt;b&gt;聞く・探す・調べる・説明する&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F8C450;strokeWidth=1.5;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="480" height="60" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・依頼を整理し、足りないことを聞く&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・規程を調べて、条番号つきで答える&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・店の候補の理由を、言葉にする&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・規程・予約画面・領収書を読み取る&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・（値はコードが検証し、人が確かめる）&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F8C450;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="480" height="330" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;コード（Cloud Run）&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#12A594;strokeColor=#12A594;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="550" y="130" width="480" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#0B6B5E&quot;&gt;&lt;b&gt;計算する・検査する・署名する・動かす&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="550" y="212" width="480" height="60" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・規程に沿った按分の計算&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・承認者・支払先の決定、店の順位&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・Policy Gate（二重の検査）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・請求・委任状への署名&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・振込の依頼、明細での入金の確認&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="550" y="284" width="480" height="330" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;人（本人の操作）&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#141D2E;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="480" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;確かめる・同意する・承認する&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8ECF4;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1060" y="212" width="480" height="60" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・幹事：計画・予約・金額を確定&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・参加者：上限つきの委任に同意&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・承認者：按分を承認&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#141D2E&quot;&gt;・口座の持ち主：銀行で振込を承認&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1060" y="284" width="480" height="330" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;AI が決めないもの・見ないもの&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;決めない&lt;/b&gt;：金額の計算、承認者、支払先、規程の変更、委任状への署名、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;　　　　　店の順位、振込の作成、「完了」の判断&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;見ない&lt;/b&gt;：実名、口座番号、銀行のトークン、署名鍵、個人ごとの回答&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;持たない&lt;/b&gt;：お金・承認・署名に当たるツール（ツールは4つだけ）&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDEE;strokeColor=#E5484D;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="990" height="210" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;だから&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;AI の出力だけでは、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;お金は動かない。&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;必ず、コードの検査と&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;人の確認・承認を通る&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F8C450;strokeWidth=2;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1060" y="640" width="480" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
