<mxfile host="app.diagrams.net" type="device"><diagram id="デモの前提" name="デモの前提"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="c1" value="デモの前提：株式会社Akakura・第一開発チームの歓送迎会（10人）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#141D2E;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="44" as="geometry"/></mxCell>
<mxCell id="c2" value="会社・規程・登場人物は、すべて架空。銀行は実験用の環境で、資金は仮想" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#5A6478;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1520" height="30" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;幹事&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#7A4E00&quot;&gt;&lt;b&gt;Web にログインした人&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;Web のチャットで依頼し、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;計画・店・予約・領収書を&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;そのつど確かめて進める&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F8C450;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="356" height="220" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;赤坂 くらお&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#7A4E00&quot;&gt;&lt;b&gt;一般の社員・参加者&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;Slack で、出欠と委任に同意。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;銀行で、自分の振込を承認&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;負担 2,100円&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8ECF4;strokeColor=#141D2E;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="422" y="130" width="356" height="220" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;赤くら 花子&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#7A4E00&quot;&gt;&lt;b&gt;部長・承認者&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;Slack で、委任に同意し、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;按分を承認&lt;/b&gt;。銀行で承認&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;負担 4,800円（端数も負担）&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8ECF4;strokeColor=#141D2E;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="804" y="130" width="356" height="220" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;ほかの5人・主役2人&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#7A4E00&quot;&gt;&lt;b&gt;名前を前面に出さない&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;出欠・委任・振込は、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;デモ用の代行。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;主役の2人は 0円&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F1F2F5;strokeColor=#5A6478;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1186" y="130" width="356" height="220" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;お金の流れ（領収書 49,500円）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;会計 49,500円 − 会社の補助 30,000円（3,000円 × 10人）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;＝ &lt;b&gt;按分の対象 19,500円&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;部長 4,800 ／ 課長 3,200 ／ 一般 2,100 × 5 ／ 新人 1,000 ／ 主役 0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;幹事への振込は7人で &lt;b&gt;17,400円&lt;/b&gt;（幹事自身の 2,100円は振込なし）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;係数は、規程 第4条（部長 2.0・課長 1.5・一般 1.0・新人 0.5）&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="740" height="250" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;画面は2つ（作りは同じ）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;実演（動画）&lt;/b&gt;：くらお・花子は、Slack と本物の銀行 API（sunabar）で&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　操作する。振込を実際に依頼し、本人が銀行のサイトで承認する&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;体験（審査員）&lt;/b&gt;：2人に届くカードを、Web の画面から押せる。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　銀行は、承認ページを模した画面。Slack も口座も要らない&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;どちらも、委任状・検査・署名・入金の確認は、同じコードで動く&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="810" y="380" width="740" height="250" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;正直に伝えること&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・銀行は sunabar（GMOあおぞらネット銀行の実験用の環境）で、&lt;b&gt;資金は仮想&lt;/b&gt;。振込依頼・本人承認・明細は、本物の API の仕様どおり&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・Slack と銀行を実際に操作するのは2人。ほかの5人の出欠・委任・振込は、デモ用の代行（検査と署名は、全員ぶんが同じコード）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・AP2 が正式に対応する支払い手段はカード。銀行振込への接続は、このプロジェクト独自の実装&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・本番で使うには、制度面（電子決済等代行業の登録など）の確認が要る&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F1F2F5;strokeColor=#C9CCD4;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1510" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
