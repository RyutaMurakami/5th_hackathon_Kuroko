<mxfile host="app.diagrams.net" type="device"><diagram id="課題" name="課題"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="c1" value="飲み会の幹事は大変。とくに、お金まわりが面倒" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#141D2E;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="44" as="geometry"/></mxCell>
