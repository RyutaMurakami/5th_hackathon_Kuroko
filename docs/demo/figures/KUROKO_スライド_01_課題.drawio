<mxCell id="c14" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;集金の声かけ&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDEE;strokeColor=#E5484D;strokeWidth=2;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="190" height="84" as="geometry"/></mxCell>
<mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6478;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c16" value="お金まわり：規程・承認・集金が絡んで、いちばん面倒" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEDEE;strokeColor=none;fontColor=#B3261E;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="850" height="34" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;按分に、会社の規程が絡む&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;役職ごとの負担割合、主役は0円、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;入社1年未満は軽減、会社の補助の上限。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;幹事が規程を読んで手で計算し、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;根拠を全員に説明する&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="480" height="220" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;承認と証跡が要る&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;誰が、どの金額表を承認したのか。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;あとから示せる必要がある&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="550" y="330" width="480" height="220" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;集金がなかなか終わらない&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;立て替えたお金を、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;1人ずつ声をかけて集める。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 23px;&quot; color=&quot;#5A6478&quot;&gt;入金の確認も、幹事の仕事&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1060" y="330" width="480" height="220" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;いまの割り勘・集金サービスでは&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;集金と領収書が中心。&lt;b&gt;金額は、幹事が決めて入力する&lt;/b&gt;。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;規程に沿った判断と、承認の証跡までは、担わない。&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F1F2F5;strokeColor=#C9CCD4;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1500" height="120" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;font style=&quot;font-size: 33px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;お金まわりまで任せたい。ただし、AI にお金を触らせるのは怖い。&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F8C450;strokeWidth=2;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1500" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
