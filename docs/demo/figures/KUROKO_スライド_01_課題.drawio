<mxCell id="c12" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;承認の取り付け&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFEDEE;strokeColor=#E5484D;strokeWidth=2;fontColor=#141D2E;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1140" y="150" width="190" height="84" as="geometry"/></mxCell>
