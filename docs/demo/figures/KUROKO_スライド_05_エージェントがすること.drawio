<mxfile host="app.diagrams.net" type="device"><diagram id="エージェントがすること" name="エージェントがすること"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="c1" value="エージェントは、自分で判断して、調べて、説明する" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#141D2E;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="44" as="geometry"/></mxCell>
<mxCell id="c2" value="ツールは4つだけ。返ってくるのは、コードが決めた事実。エージェントは、それを言葉にする" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#5A6478;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1520" height="30" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;幹事のチャット&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;「10人の歓送迎会を、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　渋谷でやりたい」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;「部長と新人の負担は、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　どう違う？」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;「お店を探して」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;「コース料金の上限は？」&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F8C450;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="330" height="430" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;Agent&lt;br&gt;Gateway&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;入口・出口を&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;Model Armor&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;で検査&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;許可した&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;宛先だけ&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8ECF4;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=center;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="150" height="430" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;kuroko-agent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;ADK・Gemini（Agent Runtime）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;・依頼を整理する&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;・足りないことだけ聞く&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;・&lt;b&gt;どのツールを使うかを、&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;　&lt;b&gt;自分で判断する&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;・結果を、理由つきで説明&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#B3261E&quot;&gt;金額は計算しない。&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#B3261E&quot;&gt;支払い・承認の約束もしない。&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="330" height="430" as="geometry"/></mxCell>
<mxCell id="c6" value="kuroko-api が公開する MCP のツール（4つだけ）" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=none;fontColor=#0B6B5E;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1010" y="112" width="540" height="30" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;retrieve_policy　規程の検索&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;規程を条ごとに探し、合う条だけを返す（全文は渡さない）&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="540" height="96" as="geometry"/></mxCell>
<mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;dashed=1;exitX=1;exitY=0.14;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;search_venues　店の検索&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;駅・地図の API を呼び、足切りと順位はコードが決める&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1010" y="260" width="540" height="96" as="geometry"/></mxCell>
<mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;dashed=1;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;check_budget　予算の確認&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;コース料金が、規程の上限以内かを確かめる&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1010" y="370" width="540" height="96" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;dashed=1;exitX=1;exitY=0.62;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;get_event_summary　イベントの概要&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 19px;&quot; color=&quot;#141D2E&quot;&gt;題名・日時・段階・人数（個人は含まない）&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1010" y="480" width="540" height="96" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;dashed=1;exitX=1;exitY=0.86;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c17" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;実際の応答（本番で確認）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;Q.「部長と新人の負担はどう違いますか？」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;A.「懇親会費用規程の&lt;b&gt;第4条&lt;/b&gt;によると、部長の負担係数は 2.0、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　入社1年未満は 0.5 です。具体的な金額の計算は、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　領収書の金額が確定してから、システムが行います」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;→ 経緯に「エージェントが、規程の文書（第4条）を参照しました」&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="730" height="230" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;記憶（Memory Bank）と、もう1つのエージェント&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・&lt;b&gt;Memory Bank&lt;/b&gt;：幹事が確かめた、決まった形の文だけを保存。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　次の企画で、同じ店の実績を、順位と理由に使う&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・&lt;b&gt;extract-agent&lt;/b&gt;：参加者の自由記述を、決まった語彙に&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　落とすだけ。ツールを持たない（隔離抽出）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・「振込先を変えて」「0円にして」は、断る（変える道具が無い）&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="750" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
