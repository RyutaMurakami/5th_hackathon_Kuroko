<mxfile host="app.diagrams.net" type="device"><diagram id="エージェントがすること" name="エージェントがすること"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="エージェントは、自分で判断し、決まった道具だけで調べて、説明する" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#141D2E;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1540" height="42" as="geometry"/></mxCell><mxCell id="n2" value="判断するのは AI（LLM）。計算・検査・許可は、すべて決まった関数（コード）。AI は必ず Gateway を通り、許可したツールだけを使う" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#5A6478;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1540" height="26" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;AI（LLM）が判断する&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#3B6FD4;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1130" y="88" width="210" height="30" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;コード（関数）が処理する&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1360" y="88" width="210" height="30" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;業務API&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;Cloud Run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;依頼を送り、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;結果を受け取る&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="180" height="170" as="geometry"/></mxCell><mxCell id="n6" value="Agent Platform" style="rounded=1;arcSize=3;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#EBCB7A;strokeWidth=1.5;fontFamily=Hiragino Sans;fontSize=17;fontStyle=1;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="235" y="128" width="930" height="640" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Agent Gateway
（入口）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;Model Armor で、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;エージェントへの&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;入力を検査&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;プロンプト&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;インジェクションの&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;検知&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E8ECF4;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="255" y="172" width="160" height="570" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;統括エージェント&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;ADK・Gemini 3.8 Flash&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;・依頼を整理し、足りないことだけ聞く&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;・どのツールを使うかを自分で判断&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;・結果を理由つきで説明&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;金額は計算しない。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;支払いも承認もしない&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#3B6FD4;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="440" y="172" width="290" height="250" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;隔離抽出エージェント&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;ツールを持たない&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;参加者の自由記述を、決まった語彙に&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;落とすだけ（命令には従わない）&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#3B6FD4;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="440" y="450" width="290" height="150" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Agent Registry&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;ツールとエージェントの名簿&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;（登録したものだけを使う）&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="440" y="628" width="290" height="114" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Callback&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;ツールを呼ぶ直前に&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;許可リスト（4つ）を&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;確かめ、それ以外は&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;コードが止める&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;LLM の判断に&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;左右されない関数&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="760" y="172" width="190" height="250" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Agent Gateway
（出口）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;許可した宛先&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;（業務API の MCP）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;だけに通す&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;それ以外の通信は&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;拒否される&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E8ECF4;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="975" y="172" width="170" height="250" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Gemini 3.8 Flash（Vertex AI）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;2つのエージェントが推論に使うモデル&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;（領収書・予約画面・規程の読み取りも&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;同じモデル。出力は、コードが検証）&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="760" y="450" width="385" height="150" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Memory Bank&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;チームの宴会実績（定型の文だけ）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot; color=&quot;#5A6478&quot;&gt;次の企画の、店の順位と理由に使う&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="760" y="628" width="385" height="114" as="geometry"/></mxCell><mxCell id="n15" value="業務API が公開する MCP ツール（4つだけ）" style="rounded=1;arcSize=3;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FBF9F4;strokeColor=#C9CDD6;strokeWidth=1.5;fontFamily=Hiragino Sans;fontSize=15;fontStyle=1;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1190" y="128" width="385" height="640" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;規程の検索&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;retrieve_policy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;規程を条ごとに探し、合う条だけを返す&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1205" y="172" width="355" height="70" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;予算の確認&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;check_budget&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;コース料金が規程の上限以内かを確かめる&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1205" y="252" width="355" height="70" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;イベントの概要&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;get_event_summary&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;題名・日時・段階・人数（個人は含まない）&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1205" y="332" width="355" height="70" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;店の検索&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;search_venues&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#5A6478&quot;&gt;足切りと順位は、コードが決める&lt;/font&gt;" style="rounded=1;arcSize=8;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1205" y="412" width="355" height="80" as="geometry"/></mxCell><mxCell id="n20" value="外部 API（コードが呼ぶ）" style="rounded=1;arcSize=3;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F2F5;strokeColor=#5A6478;strokeWidth=1.5;fontFamily=Hiragino Sans;fontSize=14;fontStyle=1;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"