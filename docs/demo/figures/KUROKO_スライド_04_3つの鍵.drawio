<mxfile host="app.diagrams.net" type="device"><diagram id="3つの鍵" name="3つの鍵"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell><mxCell id="c1" value="3つの鍵がそろわないと、振込は成立しない" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#141D2E;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="44" as="geometry"/></mxCell>
<mxCell id="c2" value="AP2 の委任状で権限を決め、銀行 API で送金する。検査は、請求する側と支払う側が別々に行う" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#5A6478;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1520" height="30" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;&lt;font style=&quot;font-size: 28px;&quot;&gt;鍵 1　本人の委任&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#7A4E00&quot;&gt;&lt;b&gt;参加者・出欠の回答のとき&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;上限額・支払先・期限を決めて、&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;支払いを任せる&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;→ AP2 の委任状に署名&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="380" height="230" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size: 28px;&quot;&gt;鍵 2　按分の承認&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#7A4E00&quot;&gt;&lt;b&gt;承認者（規程で1名）・開催のあと&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;誰がいくら払うかを確定する&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;→ 金額表のハッシュ値つきで承認&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="380" height="230" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c6" value="&lt;b&gt;&lt;font style=&quot;font-size: 28px;&quot;&gt;鍵 3　銀行での本人承認&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;font color=&quot;#7A4E00&quot;&gt;&lt;b&gt;口座の持ち主・振込ごと&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;お金を動かす最後の一押し&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;→ 銀行のサイトで、本人が承認&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#141D2E;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="380" height="230" as="geometry"/></mxCell>
<mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value="&lt;b&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;振込が成立&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#FFFFFF&quot;&gt;3つそろったときだけ&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#12A594;strokeColor=#12A594;strokeWidth=1.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1300" y="160" width="250" height="170" as="geometry"/></mxCell>
<mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value="&lt;b&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;請求する側の検査（kuroko-api）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・承認者が、規程で決まった本人である&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・承認された金額表と、請求が同じ（改ざんなし）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・請求の合計が、会計 − 補助 − 幹事の負担 と一致&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・支払先は幹事に固定。主役・幹事には請求しない&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;→ 通ったものだけ、署名つきの請求を作る&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="735" height="270" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;支払う側の検査（payment-api）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・委任状の署名が本人のもの。期限内・取り消しなし&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・請求額が、委任の上限以内&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;　（&lt;b&gt;1円でも超えたら、振込を作らない&lt;/b&gt;）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;・支払先が、委任状で許した相手（幹事）である&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 22px;&quot; color=&quot;#141D2E&quot;&gt;→ 通ったものだけ、銀行に振込を依頼する&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E0F8F3;strokeColor=#12A594;strokeWidth=1.5;fontColor=#141D2E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="815" y="410" width="735" height="270" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#141D2E;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontColor=#5A6478;labelBackgroundColor=#FFFFFF;fontFamily=Hiragino Sans;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value="Policy Gate：互いを信用せず、別々のサービスで、もう一度検査する（請求は、署名つきで渡す）" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8ECF4;strokeColor=none;fontColor=#141D2E;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1510" height="32" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;&lt;b&gt;「完了」にするのは、銀行の明細で入金を確認できたときだけ。&lt;/b&gt;応答コードだけでは完了にしない。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 24px;&quot; color=&quot;#141D2E&quot;&gt;口座番号と銀行のトークンは、bank-adapter だけが持つ。AI にも、ほかのサービスにも渡さない。&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#F8C450;strokeWidth=2;fontColor=#141D2E;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;spacingBottom=8;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1510" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
