        <mxCell id="B-001" value="完了の翌日、Slackで振り返りを依頼&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;B-001&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="380" y="124" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="U-001" value="良かった点・気になった点・満足度を回答&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;U-001&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="860" y="224" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="B-002" value="集計して定型の事実にまとめる（チーム単位・個人は特定しない）&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;B-002&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="380" y="324" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="U-002" value="記憶に残す内容をWebで確認&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;U-002&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="160" y="424" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="Q-001" value="記憶に残してよい？" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#FFFFFF;strokeColor=#757575;" vertex="1" parent="1"><mxGeometry x="155" y="524" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="B-003" value="書き込まずに終了&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;B-003&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#FFEBEE;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="380" y="532" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="B-004" value="コードが定型の事実だけを書き込む（会話からの自動生成はしない）&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;B-004&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="D-001" value="店の評価・1人あたり予算の実績を記憶&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;D-001&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="1080" y="640" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="B-005" value="次回の企画で、統括エージェントが記憶を読み取り、根拠つきで店を提案&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;B-005&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="D-002" value="読み取り専用の検索（企画・店舗提案の段階だけ）&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;D-002&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="1080" y="740" width="180" height="64" as="geometry"/></mxCell>
