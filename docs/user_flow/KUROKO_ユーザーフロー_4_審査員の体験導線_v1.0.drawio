        <mxCell id="B-003" value="按分を計算し、内訳をWebに表示&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;B-003&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="600" y="624" width="180" height="64" as="geometry"/></mxCell>
