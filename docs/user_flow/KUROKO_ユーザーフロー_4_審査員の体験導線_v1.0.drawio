        <mxCell id="U-003" value="店の候補から選び、予約画面をアップロード&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;U-003&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="160" y="424" width="180" height="64" as="geometry"/></mxCell>
