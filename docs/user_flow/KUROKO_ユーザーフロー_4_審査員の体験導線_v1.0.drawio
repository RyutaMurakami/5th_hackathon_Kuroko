        <mxCell id="A-002" value="架空の承認者・参加者の承認を代行（ラベルつき）&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#888888&quot;&gt;A-002&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=10;fontColor=#333333;fillColor=#FFEBEE;strokeColor=#D32F2F;" vertex="1" parent="1"><mxGeometry x="380" y="840" width="180" height="64" as="geometry"/></mxCell>
