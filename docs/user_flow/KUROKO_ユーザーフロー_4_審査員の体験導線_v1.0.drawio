        <mxCell id="LG-2" value="システム処理（KUROKO）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E3F2FD;strokeColor=#1E88E5;" vertex="1" parent="1"><mxGeometry x="200" y="1442" width="170" height="26" as="geometry"/></mxCell>
