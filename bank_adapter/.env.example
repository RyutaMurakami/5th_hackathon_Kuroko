# ローカル開発用。秘密の値は入れない（トークンは Secret Manager。BANK_MODE=sunabar のときだけ読む）
ENVIRONMENT=local           # local にすると、スタブの銀行が依頼を自動で承認する（ローカル専用）
BANK_MODE=stub              # stub（メモリ上の疑似銀行）| sunabar（実機）
STORE_BACKEND=memory        # memory | firestore
FIRESTORE_DATABASE=bank
SUNABAR_TOKENS_SECRET=      # projects/<project>/secrets/sunabar-tokens
BANK_ADAPTER_URL=           # 呼び出し元の ID トークンの audience（自分の URL）
API_SERVICE_ACCOUNT=
PAYMENT_API_SERVICE_ACCOUNT=
